# Настройки упрощённого сервиса генерации QR-кодов.
#
#   cp solo/.env.example solo/.env
#   chmod 600 solo/.env
#
# Файл содержит ключ доступа — права обязательны.

# ---- Ключ доступа -------------------------------------------------------
# Подставляется в адрес картинки: ?token=... Без него адрес открыт всему
# интернету, и посторонний сможет рисовать QR-коды на ваш счёт с любым
# назначением платежа.
#
# Сгенерировать:  openssl rand -base64 32
QR_TOKEN=

# ---- Реквизиты получателя (ГОСТ Р 56042-2014) ---------------------------
# Проверяются при старте: контрольные разряды счетов и ИНН должны
# сходиться, иначе контейнер не поднимется. Это намеренно — опечатка
# в счёте обнаружится сейчас, а не когда клиент не сможет заплатить.
PAYEE_NAME=ООО Ромашка
PAYEE_INN=7707083893
# КПП есть у юридического лица; у ИП его нет — оставьте пустым.
PAYEE_KPP=773601001
PAYEE_ACCOUNT=40702810000000000007
PAYEE_BANK_NAME=ПАО Сбербанк
PAYEE_BIC=044525225
PAYEE_CORR_ACCOUNT=30101810000000000007

# ---- Совместимость с шаблонами CRM --------------------------------------
# Значение параметра ?org=... из уже настроенных шаблонов. Запрос
# с другим значением получит ошибку, а не чужие реквизиты.
ORG_ALIAS=main

# ---- Оформление ---------------------------------------------------------
# Цвет модулей кода. Слишком светлый сервис не примет: такой код
# не сканируется.
# QR_COLOR=#000000
# QR_SCALE=10
# QR_BORDER=4

# Логотип в центре кода. Файл кладётся в solo/logo рядом с проектом,
# внутри контейнера каталог виден как /app/logo.
# LOGO_PATH=/app/logo/logo.png

# ---- Прочее -------------------------------------------------------------
# Сколько дней браузеры и почтовые прокси держат картинку в кэше.
# CACHE_MAX_AGE_DAYS=30
# LOG_LEVEL=INFO
