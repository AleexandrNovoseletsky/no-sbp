# Конфигурация NoSBP для рабочего окружения.
#
#   cp deploy/env.production.example .env
#   chmod 600 .env
#
# Файл содержит пароль базы и ключи хранилища: права доступа обязательны.

# ---- Общее -------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# Внешний адрес сервиса. Используется в ссылках, которые печатают
# консольные команды.
PUBLIC_BASE_URL=https://example.com

# ---- База данных -------------------------------------------------------
# Значения POSTGRES_* используются контейнером базы и скриптами
# резервного копирования, DATABASE_URL — приложением.
POSTGRES_USER=nosbp
POSTGRES_PASSWORD=ЗАМЕНИТЬ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ
POSTGRES_DB=nosbp
DATABASE_URL=postgresql+asyncpg://nosbp:ЗАМЕНИТЬ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ@postgres:5432/nosbp

# ---- Объектное хранилище логотипов -------------------------------------
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=nosbp-logos
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Панель управления -------------------------------------------------
# Собственный непубличный путь. Тот же путь указывается в конфигурации
# nginx. Значение не является средством защиты, но отсекает сканеры.
ADMIN_PATH_PREFIX=/console

# Сети, из которых разрешён вход в панель, через запятую. Дублирует
# ограничение nginx на случай прямого обращения к приложению.
# Пустое значение отключает проверку.
ADMIN_ALLOWED_NETWORKS=

ADMIN_REQUIRE_TOTP=true
ADMIN_COOKIE_SECURE=true

# ---- Оповещения о входе в панель ---------------------------------------
# Сообщение отправляется при каждом входе и при неудачных попытках.
# Канал включается, только если заданы и токен, и идентификатор чата.
#
# Telegram: токен выдаёт @BotFather, идентификатор чата — @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
#
# MAX: токен выдаёт @MasterBot, идентификатор чата приходит в обновлениях
# после первого сообщения боту.
MAX_BOT_TOKEN=
MAX_CHAT_ID=
#
# NOTIFY_ADMIN_LOGIN=true
# NOTIFY_ADMIN_LOGIN_FAILED=true
# NOTIFICATION_TIMEOUT_SECONDS=5.0

# ---- Тарификация -------------------------------------------------------
INVOICE_PRICE_KOPECKS=100
INVOICE_FREE_PERIOD_DAYS=30
OVERDRAFT_DAYS=3
OVERDRAFT_EXTENSION_DAYS=3
OVERDRAFT_MAX_EXTENSIONS=1
MIN_TOPUP_KOPECKS=100000
DEFAULT_DAILY_CHARGE_LIMIT_KOPECKS=50000
DEFAULT_ACQUIRING_FEE_BPS=70
BILLING_DAY_TIMEZONE=Europe/Moscow

# ---- Резервное копирование ---------------------------------------------
BACKUP_DIR=./backups
KEEP_DAYS=14
