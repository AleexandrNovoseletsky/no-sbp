# Общие параметры проксирования для NoSBP.
#
#   sudo cp deploy/nginx/proxy_params_nosbp /etc/nginx/proxy_params_nosbp

proxy_http_version 1.1;

proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;

# Именно $remote_addr, а не $proxy_add_x_forwarded_for: последний
# дописывает заголовок, присланный клиентом, и адрес можно подделать.
# Приложение использует первое значение заголовка для журнала и для
# ограничения доступа к панели.
proxy_set_header X-Forwarded-For   $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;

proxy_connect_timeout 5s;
proxy_send_timeout    30s;
proxy_read_timeout    30s;
