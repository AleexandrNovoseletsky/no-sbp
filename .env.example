# Скопируйте в .env и поправьте под себя: cp .env.example .env
# Здесь перечислено всё, что настраивается. Значения ниже — умолчания
# из nosbp/core/config.py; закомментированные строки менять не обязательно.

ENVIRONMENT=local
LOG_LEVEL=INFO
# Внешний адрес сервиса. Локально совпадает с адресом, проброшенным
# из docker compose.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# ---- База данных -------------------------------------------------------
# Порт 55432 — это проброшенный наружу postgres из docker compose.
DATABASE_URL=postgresql+asyncpg://nosbp:nosbp@localhost:55432/nosbp
# DB_ECHO=false

# ---- Объектное хранилище логотипов -------------------------------------
# Локально — MinIO из compose, в продакшене — Object Storage провайдера.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=nosbp-logos
S3_ACCESS_KEY=nosbp
S3_SECRET_KEY=nosbp-secret
# Без таймаутов зависшее хранилище держит поток запроса бесконечно.
# S3_CONNECT_TIMEOUT_SECONDS=3.0
# S3_READ_TIMEOUT_SECONDS=5.0
# S3_MAX_ATTEMPTS=3

# ---- Тарификация -------------------------------------------------------
# Стоимость одного счёта в копейках.
INVOICE_PRICE_KOPECKS=100
# Сколько дней повторный запрос с теми же параметрами бесплатен.
INVOICE_FREE_PERIOD_DAYS=30
# Сколько дней сервис работает в долг после исчерпания баланса.
OVERDRAFT_DAYS=3
OVERDRAFT_EXTENSION_DAYS=3
OVERDRAFT_MAX_EXTENSIONS=1
# Минимальная сумма пополнения в копейках.
MIN_TOPUP_KOPECKS=100000
# Суточный потолок списаний для новых аккаунтов. Пусто — без ограничения.
DEFAULT_DAILY_CHARGE_LIMIT_KOPECKS=50000
# Часовой пояс, по которому начинаются сутки суточного лимита.
BILLING_DAY_TIMEZONE=Europe/Moscow

# ---- Комиссия эквайринга -----------------------------------------------
# Ставка по умолчанию в базисных пунктах: 70 — это 0,7 %.
# У каждой организации ставку можно переопределить в панели.
DEFAULT_ACQUIRING_FEE_BPS=70

# ---- Панель управления -------------------------------------------------
# Путь панели. В рабочем окружении задаётся собственным непубличным
# значением; это не замена паролю и второму фактору.
ADMIN_PATH_PREFIX=/console
# Сети, из которых разрешён вход, через запятую. Пусто — без проверки.
ADMIN_ALLOWED_NETWORKS=
# Одноразовые коды из приложения-аутентификатора. Выключать только локально.
ADMIN_REQUIRE_TOTP=true
# Кука сессии только по HTTPS. На локальной машине без сертификата — false.
ADMIN_COOKIE_SECURE=true
# ADMIN_SESSION_TTL_HOURS=12
# ADMIN_SESSION_IDLE_MINUTES=60
# ADMIN_MAX_LOGIN_ATTEMPTS=5
# ADMIN_LOCKOUT_MINUTES=15

# Адрес поддержки: показывается заказчику, когда нужна помощь оператора.
SUPPORT_EMAIL=

# ---- Личный кабинет заказчика ------------------------------------------
# Путь публичный: по нему заказчики входят и регистрируются.
CABINET_PATH_PREFIX=/cabinet
# Самостоятельная регистрация. При закрытой регистрации учётные записи
# заводит оператор через панель управления.
CABINET_REGISTRATION_OPEN=true
# CABINET_SESSION_TTL_HOURS=24
# CABINET_SESSION_IDLE_MINUTES=180
# Сколько действует одноразовая ссылка для установки пароля.
# CABINET_INVITE_TTL_HOURS=72
# CABINET_MAX_LOGIN_ATTEMPTS=10
# CABINET_LOCKOUT_MINUTES=15
# Требовать подтверждение адреса почты перед входом. Включать только
# после того, как отправка писем настроена и проверена: иначе новые
# заказчики останутся без доступа.
# CABINET_REQUIRE_EMAIL_CONFIRMATION=false

# ---- Почта --------------------------------------------------------------
# Нужна для восстановления пароля, выдачи доступа в кабинет и
# подтверждения адреса. Пока настройки пусты, письма не отправляются,
# а их текст пишется в журнал — сервис при этом работает.
#
# Пароль почти у всех провайдеров — это пароль приложения, а не пароль
# от аккаунта. У Яндекса он создаётся в разделе «Пароли приложений».
#
# Проверить настройки, ничего не отправляя:
#   docker compose exec api nosbp mail check
# Проверить доставку:
#   docker compose exec api nosbp mail check --to свой@адрес
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# ssl (порт 465), starttls (587) или none — только для релея на том же хосте.
# SMTP_SECURITY=ssl
# Порт. Пусто или 0 — обычный порт выбранного режима.
# SMTP_PORT=
# Адрес в поле «От кого». Пусто — берётся SMTP_USER. Домен адреса должен
# иметь записи SPF, DKIM и DMARC, иначе письма уйдут в спам.
# SMTP_FROM=
# SMTP_FROM_NAME=NoSBP
# SMTP_TIMEOUT_SECONDS=15.0

# ---- Восстановление пароля ----------------------------------------------
# Сколько действует ссылка, запрошенная заказчиком самостоятельно.
# Короче, чем ссылка от оператора: запросить её может кто угодно.
# PASSWORD_RESET_TTL_HOURS=1
# Сколько писем о восстановлении можно запросить на один адрес за час.
# PASSWORD_RESET_MAX_PER_HOUR=3
# Сколько действует ссылка подтверждения адреса.
# EMAIL_CONFIRM_TTL_HOURS=48

# ---- Страница оплаты ----------------------------------------------------
# Публичная страница /pay/{token}: плательщик видит QR-код и реквизиты
# получателя. Пока расчётный счёт не открыт, держать выключенной —
# при выключенной настройке адрес честно отвечает 404.
PAYMENT_PAGE_ENABLED=false
# PAYMENT_PAGE_PATH_PREFIX=/pay

# ---- Оповещения о входе в панель ---------------------------------------
# Сообщение отправляется при каждом входе и при неудачных попытках.
# Канал включается, только если заданы и токен, и идентификатор чата.
#
# Telegram: токен выдаёт @BotFather, идентификатор чата — @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
#
# MAX: токен выдаёт @MasterBot, идентификатор чата приходит в обновлениях
# после первого сообщения боту.
MAX_BOT_TOKEN=
MAX_CHAT_ID=
#
# NOTIFY_ADMIN_LOGIN=true
# NOTIFY_ADMIN_LOGIN_FAILED=true
# NOTIFICATION_TIMEOUT_SECONDS=5.0

# ---- Ключи API ---------------------------------------------------------
# Как часто обновлять отметку последнего использования ключа, в секундах.
# TOKEN_LAST_USED_THROTTLE_SECONDS=300

# ---- Отрисовка QR ------------------------------------------------------
# QR_SCALE=10
# QR_BORDER=4
# LOGO_CACHE_TTL_SECONDS=600
# LOGO_CACHE_MAX_ENTRIES=512

# ---- Резервное копирование (используются скриптами в docker/) ----------
POSTGRES_USER=nosbp
POSTGRES_PASSWORD=смените-меня
POSTGRES_DB=nosbp
# BACKUP_DIR=./backups
# KEEP_DAYS=14

# Интерактивная документация API. По умолчанию включена везде,
# кроме ENVIRONMENT=production.
# ENABLE_API_DOCS=true

# ---- Тесты -------------------------------------------------------------
TEST_DATABASE_URL=postgresql+asyncpg://nosbp:nosbp@localhost:55432/nosbp_test
